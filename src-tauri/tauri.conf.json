{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GPU Monitor",
  "mainBinaryName": "gpu-monitor",
  "version": "0.1.0",
  "identifier": "dev.gpumonitor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build", "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/bundle-universal-cli.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{
      "label": "main", "title": "GPU Monitor", "width": 440, "height": 680,
      "minWidth": 380, "minHeight": 460, "resizable": true, "center": true,
      "decorations": false, "skipTaskbar": false, "visible": true,
      "backgroundColor": "#ffffff"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true, "targets": "all",
    "shortDescription": "GPU utilization and memory, at a glance",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese", "English"] } }
  }
}
